#pragma code_page(65001)
#include <winres.h>
#include "chrome_axis/accessories_dialog.hpp"
#include "chrome_axis/profiles_dialog.hpp"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_PROFILES DIALOGEX 0, 0, 365, 211
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION ""
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_MODAL_FORM, "Static", SS_LEFT | NOT WS_VISIBLE, 12, 56, 341, 54
    CONTROL "", IDC_MODAL_RESULTS, "Static", SS_LEFT | NOT WS_VISIBLE, 12, 117, 341, 54

    LTEXT "", IDC_PROFILE_LIST_LABEL, 24, 65, 315, 12
    COMBOBOX IDC_PROFILE_LIST, 24, 82, 317, 102, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT "", IDC_PROFILE_NAME_LABEL, 24, 127, 315, 12
    EDITTEXT IDC_PROFILE_NAME, 24, 144, 191, 18, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "", IDC_PROFILE_COPY, 223, 143, 118, 20

    DEFPUSHBUTTON "", IDOK, 161, 182, 87, 20
    PUSHBUTTON "", IDCANCEL, 257, 182, 84, 20
END

IDD_DEVICE_REASSIGN DIALOGEX 0, 0, 412, 216
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION ""
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_MODAL_FORM, "Static", SS_LEFT | NOT WS_VISIBLE, 12, 56, 388, 119
    LTEXT "", IDC_REASSIGN_SOURCE_LABEL, 24, 65, 364, 12
    COMBOBOX IDC_REASSIGN_SOURCE, 24, 80, 364, 116, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_REASSIGN_TARGET_LABEL, 24, 106, 364, 12
    COMBOBOX IDC_REASSIGN_TARGET, 24, 121, 364, 116, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_REASSIGN_STATUS, 24, 146, 364, 23
    DEFPUSHBUTTON "", IDOK, 208, 185, 88, 20
    PUSHBUTTON "", IDCANCEL, 304, 185, 84, 20
END
