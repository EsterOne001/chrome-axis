#pragma code_page(65001)
#include <winres.h>
#include "chrome_axis/accessories_dialog.hpp"
#include "chrome_axis/feedback_dialog.hpp"

IDD_FORCE_FEEDBACK DIALOGEX 0, 0, 400, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Retour de force · Chrome Axis"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_MODAL_FORM, "Static", SS_LEFT | NOT WS_VISIBLE, 12, 56, 376, 134
    LTEXT "", IDC_FEEDBACK_STATUS, 24, 66, 352, 25

    LTEXT "Retour de &force", -1, 24, 102, 91, 14
    COMBOBOX IDC_FEEDBACK_ENABLE, 116, 99, 93, 58, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Intensité", -1, 229, 102, 62, 14
    COMBOBOX IDC_FEEDBACK_STRENGTH, 293, 99, 83, 110, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT "&Chocs", -1, 24, 127, 91, 14
    COMBOBOX IDC_FEEDBACK_IMPACTS, 116, 124, 93, 58, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Sens de la force", -1, 229, 127, 62, 14
    COMBOBOX IDC_FEEDBACK_DIRECTION, 293, 124, 83, 58, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT "Commencez à faible intensité. Inversez le sens si la force éloigne le volant du centre.", IDC_MODAL_INTRO, 24, 154, 352, 25
    DEFPUSHBUTTON "Enre&gistrer", IDOK, 203, 200, 84, 20
    PUSHBUTTON "Annuler", IDCANCEL, 297, 200, 79, 20
END
