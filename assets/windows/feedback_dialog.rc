#pragma code_page(65001)
#include <winres.h>
#include <commctrl.h>
#include "chrome_axis/accessories_dialog.hpp"
#include "chrome_axis/feedback_dialog.hpp"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_FORCE_FEEDBACK DIALOGEX 0, 0, 400, 286
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION ""
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_MODAL_FORM, "Static", SS_LEFT | NOT WS_VISIBLE, 12, 56, 376, 188
    LTEXT "", IDC_FEEDBACK_STATUS, 24, 66, 352, 25

    LTEXT "", IDC_FEEDBACK_ENABLE_LABEL, 24, 102, 91, 14
    COMBOBOX IDC_FEEDBACK_ENABLE, 116, 99, 93, 58, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_FEEDBACK_IMPACTS_LABEL, 229, 102, 62, 14
    COMBOBOX IDC_FEEDBACK_IMPACTS, 293, 99, 83, 58, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT "", IDC_FEEDBACK_DIRECTION_LABEL, 24, 127, 91, 14
    COMBOBOX IDC_FEEDBACK_DIRECTION, 116, 124, 93, 58, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT "", IDC_FEEDBACK_STRENGTH_LABEL, 24, 149, 91, 14
    CONTROL "", IDC_FEEDBACK_STRENGTH, "msctls_trackbar32", TBS_NOTICKS | WS_TABSTOP, 113, 149, 222, 24
    RTEXT "", IDC_FEEDBACK_STRENGTH_VALUE, 340, 149, 36, 14

    LTEXT "", IDC_FEEDBACK_CENTERING_LABEL, 24, 175, 91, 14
    CONTROL "", IDC_FEEDBACK_CENTERING, "msctls_trackbar32", TBS_NOTICKS | WS_TABSTOP, 113, 175, 222, 24
    RTEXT "", IDC_FEEDBACK_CENTERING_VALUE, 340, 175, 36, 14

    LTEXT "", IDC_MODAL_INTRO, 24, 205, 352, 30
    DEFPUSHBUTTON "", IDOK, 203, 254, 84, 20
    PUSHBUTTON "", IDCANCEL, 297, 254, 79, 20
END
