#pragma code_page(65001)
#include <winres.h>
#include "chrome_axis/accessories_dialog.hpp"

IDD_ACCESSORIES DIALOGEX 0, 0, 400, 334
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Accessoires · Chrome Axis"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_MODAL_FORM, "Static", SS_LEFT | NOT WS_VISIBLE, 12, 56, 376, 132
    CONTROL "", IDC_MODAL_RESULTS, "Static", SS_LEFT | NOT WS_VISIBLE, 12, 194, 376, 98
    LTEXT "Associez une entrée à une touche du jeu. Espace commande le frein à main par défaut.", IDC_MODAL_INTRO, 24, 66, 218, 24
    PUSHBUTTON "&Boîte / palettes…", IDC_ACCESSORY_SHIFTER, 254, 65, 122, 19

    LTEXT "&Périphérique", -1, 24, 101, 70, 14
    COMBOBOX IDC_ACCESSORY_DEVICE, 99, 98, 196, 104, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Actualiser", IDC_ACCESSORY_REFRESH, 303, 97, 73, 19

    LTEXT "&Type d’entrée", -1, 24, 124, 70, 14
    COMBOBOX IDC_ACCESSORY_TYPE, 99, 121, 141, 60, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Capturer", IDC_ACCESSORY_CAPTURE, 254, 120, 122, 19
    LTEXT "", IDC_ACCESSORY_STATUS, 24, 143, 352, 22

    LTEXT "&Entrée capturée", -1, 24, 170, 72, 14
    COMBOBOX IDC_ACCESSORY_INPUT, 99, 167, 94, 100, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Touche", -1, 200, 170, 34, 14
    PUSHBUTTON "Choisir…", IDC_ACCESSORY_KEY, 235, 166, 77, 19
    PUSHBUTTON "A&jouter", IDC_ACCESSORY_ADD, 320, 166, 56, 19

    LTEXT "Associations enregistrées", IDC_MODAL_LIST_HEADING, 24, 204, 352, 14
    LISTBOX IDC_ACCESSORY_LIST, 24, 221, 352, 63, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Retirer", IDC_ACCESSORY_REMOVE, 24, 304, 73, 20
    DEFPUSHBUTTON "Enre&gistrer", IDOK, 206, 304, 82, 20
    PUSHBUTTON "Annuler", IDCANCEL, 297, 304, 79, 20
END

IDD_SHIFTER DIALOGEX 0, 0, 400, 334
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Boîte et palettes · Chrome Axis"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_MODAL_FORM, "Static", SS_LEFT | NOT WS_VISIBLE, 12, 56, 376, 132
    CONTROL "", IDC_MODAL_RESULTS, "Static", SS_LEFT | NOT WS_VISIBLE, 12, 194, 376, 98
    LTEXT "Choisissez le levier USB ou la base du volant. Pour les rapports en H, le mod de transmission doit accepter une touche par rapport.", IDC_MODAL_INTRO, 24, 66, 352, 24
    LTEXT "&Périphérique", -1, 24, 101, 70, 14
    COMBOBOX IDC_SHIFTER_DEVICE, 99, 98, 277, 125, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Mode", -1, 24, 124, 70, 14
    COMBOBOX IDC_SHIFTER_MODE, 99, 121, 130, 83, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Signal", -1, 240, 124, 39, 14
    COMBOBOX IDC_SHIFTER_SIGNAL, 283, 121, 93, 60, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_SHIFTER_STATUS, 24, 143, 352, 22
    LTEXT "Capture", IDC_SHIFTER_STEP, 24, 170, 137, 14
    LTEXT "Touche", -1, 167, 170, 43, 14
    PUSHBUTTON "Choisir…", IDC_SHIFTER_KEY, 214, 166, 84, 19
    PUSHBUTTON "Sui&vant", IDC_SHIFTER_ADVANCE, 307, 166, 69, 19
    LTEXT "Affectations capturées", IDC_MODAL_LIST_HEADING, 24, 204, 352, 14
    LISTBOX IDC_SHIFTER_LIST, 24, 221, 352, 63, LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Démarrer", IDC_SHIFTER_START, 24, 304, 82, 20
    PUSHBUTTON "Pa&sser", IDC_SHIFTER_SKIP, 115, 304, 65, 20
    DEFPUSHBUTTON "A&ppliquer", IDOK, 206, 304, 82, 20
    PUSHBUTTON "Annuler", IDCANCEL, 297, 304, 79, 20
END
