#include <winver.h>

#ifdef CHROME_AXIS_CALIBRATION_APP
#define PRODUCT_NAME "Chrome Axis"
#define PRODUCT_FILENAME "ChromeAxis.exe"
#define PRODUCT_FILETYPE VFT_APP
#else
#define PRODUCT_NAME "Chrome Axis"
#define PRODUCT_FILENAME "ChromeAxis.dll"
#define PRODUCT_FILETYPE VFT_DLL
#endif

1 VERSIONINFO
FILEVERSION CHROME_AXIS_VERSION_MAJOR,CHROME_AXIS_VERSION_MINOR,CHROME_AXIS_VERSION_PATCH,0
PRODUCTVERSION CHROME_AXIS_VERSION_MAJOR,CHROME_AXIS_VERSION_MINOR,CHROME_AXIS_VERSION_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE PRODUCT_FILETYPE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", PRODUCT_NAME
            VALUE "FileVersion", CHROME_AXIS_VERSION_WIDE
            VALUE "OriginalFilename", PRODUCT_FILENAME
            VALUE "ProductName", PRODUCT_NAME
            VALUE "ProductVersion", CHROME_AXIS_VERSION_WIDE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
